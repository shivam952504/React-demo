const shorten = (s) =>
  s.length > 22 ? s.slice(0, 22) + "…" : s;

import "./lobTable.css";

export default function LOBMetricsTable({ table }) {
  return (
    <div className="lob-table-wrapper">
      <div className="lob-table-title">
        {table.title.replace("_", " ").toUpperCase()}
        <span className="lob-table-source">
          Source: {table.file_name}
        </span>
      </div>

      <table className="lob-table">
        <thead>
          <tr>
            <th>LOB</th>
            {table.columns.map((col) => (
              <th key={col}>{col}</th>
            ))}
          </tr>
        </thead>

        <tbody>
          {table.rows.map((row, rowIndex) => (
            <tr key={rowIndex}>
              {row.show_lob && (
                <td
                  className="lob-cell"
                  rowSpan={row.rowspan}
                >
                  {row.lob}
                </td>
              )}

              {row.values.map((val, i) => (
                <td
                  key={i}
                  className={getCellClass(val)}
                >
                  {val ?? "N/A"}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

function getCellClass(value) {
  if (!value || value === "N/A") return "cell-na";

  if (typeof value === "string" && value.includes("%")) {
    const num = parseFloat(value);
    if (!isNaN(num)) {
      return num >= 95 ? "cell-good" : "cell-bad";
    }
  }

  return "";
}

