import { Table, Input, Typography, Tag } from "antd";
import { useMemo, useState } from "react";
import { useNavigate } from "react-router-dom";
import HoverPopup from "./hoverPopup/HoverPopup";
import "../index.css";

const { Text } = Typography;

/* ================= helpers ================= */

function renderPlannedActual(metric) {
  if (!metric) return "-";

  const { planned, actual, is_percent } = metric;
  if (planned == null && actual == null) return "-";

  return (
    <>
      {planned != null && (
        <>
          <Text type="secondary">P: {planned}</Text>
          <br />
        </>
      )}
      {actual != null && (
        <Text strong>
          A: {actual}
          {is_percent ? "%" : ""}
        </Text>
      )}
    </>
  );
}

function renderActual(metric) {
  if (!metric || metric.actual == null) return "-";
  return `${metric.actual}${metric.is_percent ? "%" : ""}`;
}

/* ================= metric column config ================= */

const METRIC_COLUMN_MAP = {
  headcount: {
    title: "Headcount",
    dataIndex: "headcount",
    render: renderPlannedActual,
  },
  support_nb: {
    title: "Support NB",
    dataIndex: "support_nb",
    render: renderPlannedActual,
  },
  attrition: {
    title: "Attrition rate",
    dataIndex: "attrition",
    render: renderActual,
  },
  volume: {
    title: "Volume Monthly",
    dataIndex: "volume",
    render: renderActual,
  },
  shrinkage: {
    title: "Shrinkage",
    dataIndex: "shrinkage",
    render: renderActual,
  },
  kpi: {
    title: "KPI",
    dataIndex: "kpi",
    render: (metric) =>
      metric ? (
        <>
          <Text type="secondary">C: {metric.planned}%</Text>
          <br />
          <Text type="secondary">Y: {metric.actual}%</Text>
        </>
      ) : (
        "-"
      ),
  },
  bonus: {
    title: "Bonus",
    dataIndex: "bonus",
    render: renderActual,
  },
  penalty: {
    title: "Penalty",
    dataIndex: "penalty",
    render: renderActual,
  },
  su: {
    title: "SU",
    dataIndex: "su",
    render: renderActual,
  },
  nps: {
    title: "NPS",
    dataIndex: "nps",
    render: renderActual,
  },
  esat: {
    title: "ESAT",
    dataIndex: "esat",
    render: (esat) => {
      if (!esat || esat.actual == null) return "-";
      return (
        <>
          <div>Fav: {esat.actual.favourable}%</div>
          <div>Neu: {esat.actual.neutral}%</div>
          <div>Unf: {esat.actual.unfavourable}%</div>
        </>
      );
    },
  },
  sentiment_value: {
    title: "Sentiment",
    dataIndex: "sentiment_value",
    key: "sentiment",
    align: "center",
    render: () => null,
    onCell: (record) => {
      if (record.sentiment_value == null) return {};
      const sentimentMap = {
        0: "sentiment-neutral",
        1: "sentiment-good",
        2: "sentiment-amber",
        3: "sentiment-bad",
      };
      return {
        className: sentimentMap[record.sentiment_value] || "",
      };
    },
  },
};

/* ================= main component ================= */

function ClientKpiTable({ tableRows = [], data }) {
  const navigate = useNavigate();
  const [searchText, setSearchText] = useState("");
  const [activeClientId, setActiveClientId] = useState(null);

  const dataSource = useMemo(() => {
    const normalized = normalizeTableRows(tableRows);

    if (!searchText) return normalized;

    return normalized.filter((row) =>
      row.client.toLowerCase().includes(searchText.toLowerCase())
    );
  }, [tableRows, searchText]);

  /* ===== detect which metrics exist ===== */
  const availableMetricKeys = useMemo(() => {
    const keys = new Set();

    dataSource.forEach((row) => {
      Object.keys(METRIC_COLUMN_MAP).forEach((metricKey) => {
        if (row[metricKey] != null) {
          keys.add(metricKey);
        }
      });
    });

    return Array.from(keys);
  }, [dataSource]);

  /* ===== build columns dynamically ===== */
  const columns = useMemo(() => {
    const baseColumns = [
      {
        title: "Client",
        dataIndex: "client",
        fixed: "left",
        width: 220,
        render: (text, record) => {
          const hoverData = data?.[record.client];
          return (
            <div
              onMouseEnter={() => setActiveClientId(record.client)}
              onMouseLeave={() => setActiveClientId(null)}
              style={{ position: "relative", display: "inline-block" }}
            >
              <a
                onClick={() =>
                  navigate(`/client/${record.url.split("/")[1]}/landing`)
                }
                style={{ cursor: "pointer" }}
              >
                {text}
              </a>

              {activeClientId === record.client && hoverData && (
                <HoverPopup data={hoverData} />
              )}
            </div>
          );
        },
      },
    ];

    const metricColumns = availableMetricKeys.map((key) => ({
      key,
      ...METRIC_COLUMN_MAP[key],
    }));

    return [...baseColumns, ...metricColumns];
  }, [availableMetricKeys, data, activeClientId, navigate]);

  return (
    <div className="client-kpi-wrapper">
      <div className="client-kpi-header">
        <div className="client-kpi-title">
          Client Level KPIs <Tag>All geos</Tag>
        </div>

        <Input.Search
          placeholder="Search client..."
          allowClear
          onChange={(e) => setSearchText(e.target.value)}
          style={{ width: 220 }}
        />
      </div>

      <Table
        columns={columns}
        dataSource={dataSource}
        pagination={false}
        scroll={{ x: "max-content", y: 420 }}
        size="middle"
        tableLayout="fixed"
      />
    </div>
  );
}

export default ClientKpiTable;

/* ================= normalization ================= */

function normalizeTableRows(tableRows = []) {
  return tableRows.map((row) => {
    const metricMap = {};
    row.metrics.forEach((m) => {
      metricMap[m.id] = m;
    });

    return {
      key: row.client_name,
      client: row.client_name,
      url: row.url,
      headcount: metricMap.headcount,
      support_nb: metricMap.support_nb,
      attrition: metricMap.attrition,
      volume: metricMap.volume_monthly,
      shrinkage: metricMap.shrinkage,
      kpi: metricMap.kpi_attainment,
      bonus: metricMap.bonus,
      penalty: metricMap.penalty,
      su: metricMap.su,
      nps: metricMap.nps,
      esat: metricMap.esat,
      sentiment_value: row.sentiment_value,
      sentiment_class: row.sentiment_class,
    };
  });
}
